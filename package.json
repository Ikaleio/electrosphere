{
  "name": "electrosphere",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/daemon/index.ts",
    "start": "bun src/daemon/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "agent:build": "cargo build --manifest-path agent/Cargo.toml --release --target x86_64-unknown-linux-musl"
  },
  "dependencies": {
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
